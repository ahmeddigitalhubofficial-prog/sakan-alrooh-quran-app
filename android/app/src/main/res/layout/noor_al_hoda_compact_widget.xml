<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- App title / Icon -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:text="✨ سكن الروح"
        android:textColor="#E5C158"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Next prayer name -->
    <TextView
        android:id="@+id/widget_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_alignParentRight="true"
        android:layout_marginTop="6dp"
        android:text="الصلاة القادمة: الفجر"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Prayer time -->
    <TextView
        android:id="@+id/widget_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_prayer_name"
        android:layout_alignParentRight="true"
        android:layout_marginTop="2dp"
        android:text="الوقت: 04:30 ص"
        android:textColor="#64D2FF"
        android:textSize="12sp" />

    <!-- Countdown badge -->
    <TextView
        android:id="@+id/widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:background="@drawable/widget_badge_bg"
        android:paddingVertical="4dp"
        android:text="باقي 02 س و 15 د"
        android:textColor="#FFD60A"
        android:textSize="11sp"
        android:textStyle="bold" />

</RelativeLayout>
